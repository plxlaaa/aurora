# =============================================================================
# 网关密钥与覆盖配置示例
#
# 安装（仅 root 可读，600）：
#   sudo install -d -m 700 /etc/aiassistant
#   sudo install -m 600 deploy/gateway.env.example /etc/aiassistant/gateway.env
#   sudo vi /etc/aiassistant/gateway.env
#   sudo systemctl restart aiassistant-gateway
#
# 本文件由 systemd 以 EnvironmentFile 加载：不要写 `export` 前缀，
# 每行一组 KEY=VALUE，`#` 开头为注释。
# =============================================================================

# ---------- 鉴权 ----------
# 设为非空即启用鉴权（强烈建议）。生成强随机值：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AI_ASSISTANT_API_KEY=

# JWT 签名密钥：显式设置可保证重启后已签发的 token 依然有效
AI_ASSISTANT_JWT_SECRET=

# ---------- 反向代理与跨域 ----------
# 网关在 nginx 之后时保持 true（网关据此取 X-Forwarded-For 作为客户端 IP）
AI_ASSISTANT_TRUST_PROXY=true
# 逗号分隔允许的跨域来源；同源部署（nginx / 网关内置前端）请留空
AI_ASSISTANT_CORS_ORIGINS=

# ---------- 运行参数 ----------
AI_ASSISTANT_LOG_LEVEL=INFO
# 结构化 JSON 日志：true 时每行一条 JSON，便于 Loki / ES 采集
AI_ASSISTANT_LOG_JSON=false
AI_ASSISTANT_MAX_CONCURRENT_GENERATIONS=3
AI_ASSISTANT_MAX_BODY_MB=24
AI_ASSISTANT_SLOW_REQUEST_MS=30000

# ---------- 模型端点默认值（也可在设置页配置，或写config/models.local.yaml） ----------
# 注意：API Key 等敏感值建议写在 /opt/aiassistant/config/models.local.yaml，
#该文件不入 git，且不会随配置文件一起分发。