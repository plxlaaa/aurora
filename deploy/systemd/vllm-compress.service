# =============================================================================
# vllm-compress.service —— vLLM 文本压缩/蒸馏模型服务（OpenAI 兼容端点）
#
# 说明：
#   - 提供长文本压缩、上下文蒸馏等能力，网关通过 base_url 指向本服务（8003）
#   - 通常是小体积模型，显存占用低，可与 main 共卡也可独立
#   - 本文为“占位示例”：--model、--port 均可按需替换
# =============================================================================
[Unit]
Description=vLLM Compressor Model (OpenAI-compatible, compress 压缩模型)
After=network.target

[Service]
Type=simple
User=aiassistant
Group=aiassistant
WorkingDirectory=/opt/aiassistant

# ---- 可选环境变量（按需取消注释修改）----
# Environment=CUDA_VISIBLE_DEVICES=0

# 占位示例：文本压缩模型，监听 8003 端口
# 请按实际需要替换 --model、--port、--served-model-name
ExecStart=vllm serve Qwen/Qwen2.5-1.5B-Instruct --port 8003 --served-model-name compress --host 127.0.0.1 --max-model-len 16384

Restart=on-failure
RestartSec=5

ExecStopPost=-/usr/bin/rm -f /dev/shm/vllm_*
PrivateTmp=true

[Install]
WantedBy=multi-user.target