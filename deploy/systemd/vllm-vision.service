# =============================================================================
# vllm-vision.service —— vLLM 视觉理解模型服务（OpenAI 兼容端点）
#
# 说明：
#   - 负责图像/多模态输入理解，网关通过 base_url 指向本服务（端口 8002）
#   - 本文为“占位示例”：--model 模型名、--port 端口均可按需替换
#   - 需要较大的显存；多卡时建议独立 GPU（CUDA_VISIBLE_DEVICES）运行
# =============================================================================
[Unit]
Description=vLLM Vision Model (OpenAI-compatible, vision 视觉模型)
After=network.target

[Service]
Type=simple
User=aiassistant
Group=aiassistant
WorkingDirectory=/opt/aiassistant

# ---- 可选环境变量（按需取消注释修改）----
# Environment=CUDA_VISIBLE_DEVICES=1
# Environment=VLLM_SKIP_WARMUP=false

# 占位示例：视觉模型，监听 8002 端口
# 请按实际需要替换 --model、--port、--served-model-name
ExecStart=vllm serve Qwen/Qwen2.5-VL-7B-Instruct --port 8002 --served-model-name vision --host 127.0.0.1 --max-model-len 12288

Restart=on-failure
RestartSec=5

ExecStopPost=-/usr/bin/rm -f /dev/shm/vllm_*
PrivateTmp=true

[Install]
WantedBy=multi-user.target