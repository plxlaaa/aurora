# =============================================================================
# aiassistant-gateway.service —— AI 智能助手网关 (FastAPI) 服务
#
# 安装：
#   sudo cp deploy/systemd/aiassistant-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aiassistant-gateway
#
# 密钥与覆盖配置统一放在 /etc/aiassistant/gateway.env（权限 600，不入版本库）：
#   sudo install -m 600 deploy/gateway.env.example /etc/aiassistant/gateway.env
#   sudo vi /etc/aiassistant/gateway.env    # 填入 API_KEY / JWT_SECRET
#   sudo systemctl restart aiassistant-gateway
#
# 安全说明：
#   - 以非特权用户 aiassistant 运行；
#   - 只监听 127.0.0.1:8080，外部流量由 nginx 反代进入；
#   - 启用 systemd 沙箱加固（ProtectSystem=strict + ReadWritePaths 白名单）。
# =============================================================================
[Unit]
Description=AI Assistant Gateway (FastAPI, single node 单机网关)
Documentation=https://github.com/plxlaaa/aurora
After=network-online.target
Wants=network-online.target
# 建议等模型推理服务先起来；未就绪时网关会自动重试，故为弱依赖
Wants=vllm-main.service

[Service]
Type=simple
# 以非特权用户运行，避免以 root 运行泄露风险
User=aiassistant
Group=aiassistant
WorkingDirectory=/opt/aiassistant/backend

Environment=PATH=/opt/aiassistant/backend/venv/bin
# ---- 网关运行路径配置（与 deploy/install.sh 的安装位置保持一致）----
Environment=AI_ASSISTANT_CONFIG_DIR=/opt/aiassistant/config
Environment=AI_ASSISTANT_DATA_DIR=/opt/aiassistant/data/sessions
Environment=AI_ASSISTANT_SKILLS_DIR=/opt/aiassistant/config/skills
Environment=AI_ASSISTANT_UPLOAD_DIR=/opt/aiassistant/data/uploads
# 网关直接托管前端构建产物，免去单独配置 nginx 静态站点
Environment=AI_ASSISTANT_FRONTEND_DIR=/opt/aiassistant/frontend/dist
# ---- 运行时行为 ----
Environment=AI_ASSISTANT_HOST=127.0.0.1
Environment=AI_ASSISTANT_PORT=8080
Environment=AI_ASSISTANT_LOG_LEVEL=INFO
Environment=AI_ASSISTANT_TRUST_PROXY=true
Environment=AI_ASSISTANT_MAX_CONCURRENT_GENERATIONS=3
Environment=AI_ASSISTANT_MAX_BODY_MB=24

# 密钥与覆盖项（文件不存在时因 "-" 前缀被安全跳过）
EnvironmentFile=-/etc/aiassistant/gateway.env

# uvicorn 启动参数：--proxy-headers 让网关正确识别反代后的客户端 IP（日志与登录限流依赖）
ExecStart=/opt/aiassistant/backend/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8080 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --timeout-keep-alive 65 \
    --log-level info

# 异常退出时自动重启，间隔 5 秒；正常 stop（systemctl stop）不会被拉起
Restart=on-failure
RestartSec=5
# 优雅退出：给在跑的流式生成最多 30s 收尾时间
KillSignal=SIGTERM
TimeoutStopSec=30

# ---- 资源与可靠性 ----
LimitNOFILE=65535
# 内存上限（按机器规格调整，默认不限制）
# MemoryMax=4G

# ---- 日志：统一交给 journald，journalctl -u aiassistant-gateway 查看/跟踪 ----
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aiassistant-gateway

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# ProtectSystem=strict 下必须显式声明可写路径
ReadWritePaths=/opt/aiassistant/data /opt/aiassistant/logs /opt/aiassistant/config

[Install]
WantedBy=multi-user.target