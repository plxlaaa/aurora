# =============================================================================
# Aurora 环境变量示例
#
# 复制为 .env 后按需修改：
#   Linux/macOS : cp deploy/.env.example deploy/.env
#   Windows     : Copy-Item deploy\.env.example deploy\.env
#
# 该文件仅被 docker-compose 与安装脚本读取；请勿提交含真实密钥的 .env
# （已在 .gitignore 中忽略 *.local 与 .env）。
# =============================================================================

# ---------- 站点与端口 ----------
# 网关对外端口（docker-compose 映射的宿主机端口）
AURORA_PORT=8080
# 网关对外监听地址：
#   127.0.0.1 = 仅本机（推荐，配合 nginx/IIS 反代对外）
#   0.0.0.0   = 允许外部直连（务必同时启用鉴权与防火墙）
AURORA_BIND=127.0.0.1
# 前端构建产物目录（供 AI_ASSISTANT_FRONTEND_DIR 使用；容器内已内置，一般无需设置）
# AI_ASSISTANT_FRONTEND_DIR=/opt/aiassistant/frontend/dist

# ---------- 鉴权（生产环境务必配置） ----------
# 设置后网关启用 JWT/API Key 鉴权；留空则不鉴权（仅限内网调试）
AI_ASSISTANT_API_KEY=
# JWT 签名密钥：显式设置可保证进程重启后已签发的 token 仍然有效。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_ASSISTANT_JWT_SECRET=

# ---------- 运行时行为 ----------
# 生产模式：true 时关闭 /docs 与 /openapi.json，并对响应启用更严格的默认策略
AI_ASSISTANT_PRODUCTION=true
# 日志级别：DEBUG / INFO / WARNING / ERROR
AI_ASSISTANT_LOG_LEVEL=INFO
# 结构化 JSON 日志：true 时每行一条 JSON（ts/level/logger/msg/request_id），
# 便于 Loki / Elasticsearch 等采集；默认 false 走人类可读文本
AI_ASSISTANT_LOG_JSON=false
# 逗号分隔的允许跨域来源；同源部署（nginx/容器内置前端）可留空
AI_ASSISTANT_CORS_ORIGINS=
# 全局并发生成上限（同一时刻最多在跑的几轮对话）
AI_ASSISTANT_MAX_CONCURRENT_GENERATIONS=3
# 单请求体上限（MB）；需 >= 附件 base64 膨胀后的体积，默认 24
AI_ASSISTANT_MAX_BODY_MB=24
# 慢请求告警阈值（毫秒）
AI_ASSISTANT_SLOW_REQUEST_MS=30000
# 是否信任反向代理的 X-Forwarded-*（nginx/IIS 在前时保持 true）
AI_ASSISTANT_TRUST_PROXY=true

# ---------- 目录（按安装方式二选一，通常无需修改） ----------
# Linux/macOS 默认
AI_ASSISTANT_CONFIG_DIR=/opt/aiassistant/config
AI_ASSISTANT_DATA_DIR=/opt/aiassistant/data/sessions
AI_ASSISTANT_UPLOAD_DIR=/opt/aiassistant/data/uploads
AI_ASSISTANT_SKILLS_DIR=/opt/aiassistant/config/skills
# Windows 默认（NSSM 服务注册脚本使用）
AI_ASSISTANT_WINDOWS_CONFIG_DIR=C:\ProgramData\Aurora\config
AI_ASSISTANT_WINDOWS_DATA_DIR=C:\ProgramData\Aurora\data\sessions
AI_ASSISTANT_WINDOWS_UPLOAD_DIR=C:\ProgramData\Aurora\data\uploads

# ---------- Docker 专用 ----------
AURORA_VERSION=1.3.0
AURORA_CONFIG_DIR=./config
PYTHON_BASE=python:3.11-slim
TZ=Asia/Shanghai
# 启用内置 nginx 时使用
# NGINX_SERVER_NAME=ai.example.com
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# ---------- 模型服务（systemd 部署 vLLM 时使用） ----------
# 主模型 / 视觉模型 / 压缩模型 served-model-name
AURORA_MODEL_MAIN=qwen2.5:7b-instruct
AURORA_MODEL_VISION=qwen2.5-vl:7b-instruct
AURORA_MODEL_COMPRESS=qwen2.5:3b-instruct
AURORA_VLLM_GPU_MEMORY_UTILIZATION=0.85