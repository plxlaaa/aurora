{
  "llm": {
    "provider": "openai",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "api_key_env": "AURORA_API_KEY"
  },
  "update": {
    "enabled": true,
    "channel_race": true,
    "timeout_ms": 20000,
    "repo": "plxlaaa/aurora",
    "mirrors": ["github", "ghproxy", "ghproxy_net", "gitdl", "gh_ddlc"]
  },
  "agent": {
    "max_steps": 32,
    "shell": "auto",
    "confirm_shell": true
  }
}
